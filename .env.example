# Docker Compose development settings. Copy to .env and replace the placeholders.
APP_ENV=development
POSTGRES_USER=it_support
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=it_support
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DATA_PROCESSING_APPROVED=false
AI_RESOLUTION_CONFIDENCE_THRESHOLD=0.75
