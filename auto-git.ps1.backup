Write-Host "========================================"
Write-Host " Intelligent IT Support - Auto Git"
Write-Host "========================================"
Write-Host ""
Write-Host "Watching for changes..."
Write-Host "Press Ctrl+C to stop."
Write-Host ""

function Get-StatusPath($statusLine) {
    $path = $statusLine.Substring(3)
    if ($path -match " -> ") {
        $path = $path.Split(" -> ")[-1]
    }
    return $path
}

function Test-MeaningfulPath($path) {
    return $path -notmatch "(?i)(^|/)(\.venv|__pycache__|\.pytest_cache|\.mypy_cache|\.ruff_cache|node_modules|\.next|dist|build|coverage|secrets|logs)(/|$)" -and
        $path -notmatch "(?i)(^|/)\.env(\..*)?$" -and
        $path -notmatch "(?i)\.pyc$"
}

function Get-MeaningfulChanges {
    $status = @(git status --porcelain --untracked-files=all)
    return @($status | Where-Object { Test-MeaningfulPath (Get-StatusPath $_) })
}

while ($true) {
    $changes = @(Get-MeaningfulChanges)

    if ($changes.Count -gt 0) {
        Write-Host ""
        Write-Host "Changes detected" -ForegroundColor Cyan
        Write-Host "Waiting for edits to settle..." -ForegroundColor Yellow
        Start-Sleep -Seconds 10

        $stableChanges = @(Get-MeaningfulChanges)

        if ($stableChanges.Count -eq 0) {
            Write-Host "No meaningful changes" -ForegroundColor DarkGray
            Start-Sleep -Seconds 5
            continue
        }

        $diffCheck = @(git diff --check 2>&1)
        if ($LASTEXITCODE -ne 0) {
            Write-Host "git diff --check failed:" -ForegroundColor Red
            $diffCheck | ForEach-Object { Write-Host $_ -ForegroundColor Red }
            Start-Sleep -Seconds 5
            continue
        }

        $meaningfulPaths = @($stableChanges | ForEach-Object { Get-StatusPath $_ })
        git add -- $meaningfulPaths

        $stagedDiffCheck = @(git diff --cached --check 2>&1)
        if ($LASTEXITCODE -ne 0) {
            Write-Host "git diff --check failed for staged changes:" -ForegroundColor Red
            $stagedDiffCheck | ForEach-Object { Write-Host $_ -ForegroundColor Red }
            Start-Sleep -Seconds 5
            continue
        }

        git diff --cached --quiet
        if ($LASTEXITCODE -eq 0) {
            Write-Host "No meaningful changes" -ForegroundColor DarkGray
            Start-Sleep -Seconds 5
            continue
        }

        Write-Host "Committing" -ForegroundColor Cyan
        $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        git commit -m "auto: save changes $timestamp"

        if ($LASTEXITCODE -ne 0) {
            Write-Host "Commit failed; changes were not discarded." -ForegroundColor Red
            Start-Sleep -Seconds 5
            continue
        }

        Write-Host "Pushing" -ForegroundColor Cyan
        git push origin main

        if ($LASTEXITCODE -eq 0) {
            Write-Host "Success" -ForegroundColor Green
        }
        else {
            Write-Host "Push failed; changes were not discarded." -ForegroundColor Red
        }

        Write-Host ""
    }

    Start-Sleep -Seconds 5
}